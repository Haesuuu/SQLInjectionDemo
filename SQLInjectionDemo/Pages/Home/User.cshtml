@page
@using Microsoft.EntityFrameworkCore
@using SQLInjectionDemo.Data
@using SQLInjectionDemo.Models
@inject AppDbContext _context
@{
    ViewData["Title"] = "My Profile";
    Layout = null;
}

@functions {
    public User? Member { get; set; }
    public List<User> Members { get; set; } = new();

    public IActionResult OnGet()
    {
        var userId = HttpContext.Session.GetInt32("DemoUserId");
        if (!userId.HasValue)
        {
            return RedirectToPage("/Account/ParameterizedLogin");
        }

        Member = _context.Users
            .AsNoTracking()
            .FirstOrDefault(user => user.UserID == userId.Value);

        if (Member is null)
        {
            HttpContext.Session.Remove("DemoUserId");
            return RedirectToPage("/Account/ParameterizedLogin");
        }

        if (Member.RoleID == 1)
        {
            return RedirectToPage("/Admin/Admin");
        }

        Members = _context.Users
            .AsNoTracking()
            .Where(user => user.UserID != Member.UserID)
            .OrderBy(user => user.UserName)
            .ToList();

        return Page();
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JISSA</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="dashboard-body">
    <nav class="dashboard-nav">
        <a class="dashboard-brand" href="/Home/User">JISSA <span>SQL Demo</span></a>
        <div class="dashboard-nav-links">
            <span class="nav-status">User view</span>
            <a href="/Account/ParameterizedLogin">Log out</a>
        </div>
    </nav>

    <main class="dashboard-shell">
        <section class="dashboard-hero">
            <div>
                <p class="eyebrow">Member area</p>
                <h1>Your profile</h1>
                <p>Only the member username and bio are shown in this demonstration profile.</p>
            </div>
            <div class="hero-mark">01</div>
        </section>

        <section class="profile-panel" aria-label="Your member profile">
            @if (Member is not null)
            {
                <a class="profile-link" href="/Profile?userId=@Member.UserID" aria-label="View your profile">
                    <partial name="_MemberProfileCard" model="Member" />
                </a>
            }
        </section>

        <section class="members-section" aria-labelledby="members-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Community</p>
                    <h2 id="members-heading">Browse members</h2>
                </div>
                <span class="member-count">@Members.Count members</span>
            </div>

            <div class="member-list">
                @foreach (var member in Members)
                {
                    <a class="member-list-item" href="/Profile?userId=@member.UserID">
                        <span class="member-list-avatar">@member.UserName.Substring(0, 1).ToUpperInvariant()</span>
                        <span class="member-list-name">@member.UserName</span>
                        <span class="member-list-arrow" aria-hidden="true">→</span>
                    </a>
                }
            </div>
        </section>

        <p class="demo-footnote">Bios are intentionally rendered without encoding for the local XSS demonstration.</p>
    </main>
</body>
</html>
