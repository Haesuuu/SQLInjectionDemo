@page
@using Microsoft.EntityFrameworkCore
@using SQLInjectionDemo.Data
@using SQLInjectionDemo.Models
@inject AppDbContext _context
@{
    ViewData["Title"] = "Member Profiles";
    Layout = null;
}

@functions {
    public List<User> Members { get; set; } = new();

    public IActionResult OnGet()
    {
        var userId = HttpContext.Session.GetInt32("DemoUserId");
        if (!userId.HasValue)
        {
            return RedirectToPage("/Account/ParameterizedLogin");
        }

        var currentUser = _context.Users
            .AsNoTracking()
            .FirstOrDefault(user => user.UserID == userId.Value);

        if (currentUser is null)
        {
            HttpContext.Session.Remove("DemoUserId");
            return RedirectToPage("/Account/ParameterizedLogin");
        }

        if (currentUser.RoleID != 1)
        {
            return RedirectToPage("/Home/User");
        }

        Members = _context.Users
            .AsNoTracking()
            .OrderBy(user => user.UserName)
            .ToList();

        return Page();
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JISSA</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="dashboard-body">
    <nav class="dashboard-nav">
        <a class="dashboard-brand" href="/Admin/Admin">JISSA <span>SQL Demo</span></a>
        <div class="dashboard-nav-links">
            <span class="nav-status">Admin view</span>
            <a href="/Account/ParameterizedLogin">Log out</a>
        </div>
    </nav>

    <main class="dashboard-shell">
        <section class="dashboard-hero">
            <div>
                <p class="eyebrow">Administrator area</p>
                <h1>Member profiles</h1>
                <p>Review the username and bio for every member in the demonstration database.</p>
            </div>
            <div class="hero-mark">@Members.Count.ToString("00")</div>
        </section>

        <section class="profile-grid" aria-label="All member profiles">
            @foreach (var member in Members)
            {
                <a class="profile-link" href="/Profile?userId=@member.UserID" aria-label="View @member.UserName profile">
                    <partial name="_MemberProfileCard" model="member" />
                </a>
            }
        </section>

        <p class="demo-footnote">The bio is intentionally rendered without encoding for the local XSS demonstration.</p>
    </main>
</body>
</html>
