@page
@using Microsoft.EntityFrameworkCore
@using SQLInjectionDemo.Data
@inject AppDbContext _context

@{
    ViewData["Title"] = "Parameterized - Login";
    Layout = "~/Pages/Shared/_LoginLayout.cshtml";
}


@functions {
    [Microsoft.AspNetCore.Mvc.BindProperty]
    public string UserName { get; set; } = string.Empty;

    [Microsoft.AspNetCore.Mvc.BindProperty]
    public string Password { get; set; } = string.Empty;

    public void OnGet()
    {
        HttpContext.Session.Remove("DemoUserId");
    }

    public IActionResult OnPostLogin()
    {
        if (!ModelState.IsValid)
        {
            return Page();
        }

        try
        {
            var users = _context.Users
                .FromSqlInterpolated($@"
                    SELECT *
                    FROM Users
                    WHERE (UserName = {UserName} OR EmailAdd = {UserName})
                    AND Password = {Password}")
                .ToList();

            var user = users.FirstOrDefault();

            if (user == null)
            {
                ModelState.AddModelError(
                    string.Empty,
                    "Invalid login credentials.");

                return Page();
            }

            // Demo-only identity state. This is not intended to replace real authentication.
            HttpContext.Session.SetInt32("DemoUserId", user.UserID);

            var roleName = _context.Roles
                .AsNoTracking()
                .Where(role => role.RoleID == user.RoleID)
                .Select(role => role.RoleName)
                .FirstOrDefault();

            if (roleName == "Administrator" || user.RoleID == 1)
            {
                return RedirectToPage("/Admin/Admin");
            }

            if (roleName == "Member" || user.RoleID == 2)
            {
                return RedirectToPage("/Home/User");
            }

            ModelState.AddModelError(
                string.Empty,
                "Account has an invalid role.");

            return Page();
        }
        catch (Exception ex)
        {
            ModelState.AddModelError(
                string.Empty,
                $"An error occurred while logging in: {ex.Message}");

            return Page();
        }
    }
}

<nav class="demo-navbar">
    <a class="navbar-brand" href="/Account/ParameterizedLogin">JISSA <span>SQL Demo</span></a>
    <div class="navbar-links">
        <a href="/Account/Login">Vulnerable login</a>
        <a class="active" href="/Account/ParameterizedLogin">Safe login</a>
    </div>
</nav>

<div class="login-container">

    

    <div class="login-image-section">
        <img src="~/Images/jissa.jpg"
             alt="JISSA"
             class="login-image" />
    </div>

    <div class="login-form-section">

        <div class="login-form-wrapper">

            <div class="login-logo">
                <div class="login-logo-text">PARAMETERIZED</div>
                <div class="login-logo-sub">QUERY</div>
            </div>

            <h2 class="login-title">Welcome</h2>
            <p class="login-subtitle">Use credentials safely with parameters</p>

            <div class="demo-callout safe-callout">
                <strong>Parameterized query</strong>
                <span>Input is sent as data, so SQL operators remain ordinary text.</span>
            </div>

            @if (!ModelState.IsValid && ModelState.ErrorCount > 0)
            {
                <div class="alert-login alert-error">
                    @Html.ValidationSummary(false)
                </div>
            }

            <form method="post"
                  asp-page-handler="Login"
                  class="login-form">

                @Html.AntiForgeryToken()

                <div class="form-group-login">
                    <label class="form-label-login">
                        Username or Email
                    </label>

                    <input type="text"
                           class="form-input-login"
                           name="UserName"
                           placeholder="Enter your username or email"
                           required />
                </div>

                <div class="form-group-login">
                    <label class="form-label-login">
                        Password
                    </label>

                    <input type="password"
                           class="form-input-login"
                           name="Password"
                           placeholder="Enter your password"
                           required />
                </div>

                <button type="submit" class="btn-login">
                    Sign In
                </button>

            </form>

            <p class="login-switch">Need an account? <a href="/Account/Register">Create one</a></p>

        </div>

    </div>

</div>
